# Copy to `.env` and adjust. Nothing here is required to run — with no API key
# the agent uses the deterministic mock LLM so the whole stack still works.

# --- LLM provider: anthropic | ollama | mock ---
LLM_PROVIDER=anthropic
# Get a key at https://console.anthropic.com . If LLM_PROVIDER=anthropic but this
# is empty, the app automatically falls back to the mock LLM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Fully-local option (requires: docker compose --profile local up, then
# `docker compose exec ollama ollama pull llama3.1`)
OLLAMA_MODEL=llama3.1

# --- Vector DB ---
# Inside docker-compose this is overridden to http://qdrant:6333 automatically.
# For running the app outside docker, point it at your local Qdrant:
# QDRANT_URL=http://localhost:6333
QDRANT_URL=http://qdrant:6333

# --- Harness tuning ---
MAX_AGENT_STEPS=6
TEMPERATURE=0.2
